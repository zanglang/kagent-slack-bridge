# Copy to .env for local dev (uv run bridge.py). In-cluster these come from
# the kagent-slack-bridge Secret (Doppler ExternalSecret) — see k8s/.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
KAGENT_A2A_URL=http://localhost:8083/api/a2a/kagent/k8s-agent/
# KAGENT_TIMEOUT=600
# SLACK_COMMAND=/kagent
# LOG_LEVEL=INFO
