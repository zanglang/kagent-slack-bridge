{
  "display_information": {
    "name": "kagent",
    "description": "Ask the kagent Kubernetes agent about the cluster",
    "background_color": "#1f2933"
  },
  "features": {
    "bot_user": {
      "display_name": "kagent",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/kagent",
        "description": "Ask the kagent Kubernetes agent",
        "usage_hint": "how many pods are not ready?",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "channels:history",
        "groups:history",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
